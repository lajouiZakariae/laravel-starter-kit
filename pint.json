{
    "preset": "laravel",
    "rules": {
        "braces_position": {
            "classes_opening_brace": "same_line",
            "functions_opening_brace": "same_line",
            "control_structures_opening_brace": "same_line"
        },
        "single_quote": {
            "strings_containing_single_quote_chars": true
        },
        "concat_space": {
            "spacing": "one"
        }
    }
}
